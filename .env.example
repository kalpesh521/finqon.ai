# Copy to .env and fill in. .env is gitignored; never commit real values.
#
# Local PostgreSQL 16 (docker compose service `postgres`, image pgvector/pgvector:pg16).
# FINQON_POSTGRES_PASSWORD is the superuser password and, inside Compose, the password
# of finqon_api, finqon_reader, and finqon_loader. The roles stay separate: the reader
# is read-only and cannot bypass row-level security. Use a URL-safe password (no @ : / ?).
# Change it before this database is reachable from anywhere but your machine.
#
# The four URLs below are for processes on the host (make setup, uvicorn).
# Containers replace the host with `postgres`. Do not put the superuser in the reader URL.
# sslmode=disable is correct on this local server. A hosted Postgres that requires TLS
# keeps ?sslmode=require; the URL parser already accepts that.

FINQON_POSTGRES_PASSWORD=finqon_local_dev
# Published on the host. 5432 is often already taken by another Postgres.
FINQON_POSTGRES_PORT=5433

# --- Application roles (created by `python -m finqon.db.bootstrap_roles`) ---------------
FINQON_API_DATABASE_URL=postgresql://finqon_api:finqon_local_dev@localhost:5433/finqon?sslmode=disable
FINQON_READER_DATABASE_URL=postgresql://finqon_reader:finqon_local_dev@localhost:5433/finqon?sslmode=disable
FINQON_LOADER_DATABASE_URL=postgresql://finqon_loader:finqon_local_dev@localhost:5433/finqon?sslmode=disable

# --- One-off setup only: the database owner (local superuser `finqon`) -----------------
# Used by role bootstrap and Alembic. The running API does not need it.
FINQON_ADMIN_DATABASE_URL=postgresql://finqon:finqon_local_dev@localhost:5433/finqon?sslmode=disable
# Password for the two seed users (kalpeshpawar@gmail.com / seed.isolation@finqon.example).
# At least 10 characters. Local default; change it on a shared machine.
FINQON_SEED_PASSWORD=finqon-seed-local

# --- Auth ---------------------------------------------------------------------------------
# At least 32 characters. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
FINQON_JWT_SECRET=
FINQON_JWT_ACCESS_TTL_MINUTES=15
FINQON_JWT_REFRESH_TTL_DAYS=14
FINQON_JWT_ISSUER=finqon.ai

# --- LLM gateway (any OpenAI-compatible endpoint; default is Gemini) -----------------------
FINQON_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
FINQON_LLM_API_KEY=
FINQON_LLM_MODEL=gemini-flash-latest

# --- API ---------------------------------------------------------------------------------
# Comma-separated list of allowed browser origins.
FINQON_CORS_ORIGINS=http://localhost:5173
FINQON_TIMEZONE=Asia/Kolkata
