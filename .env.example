# Copy to .env and fill in. .env is gitignored; never commit real values.
#
# Neon: use the DIRECT (session) connection strings, not the transaction-mode pooler.
# Each URL below uses its OWN role. Never put the Neon owner role in the reader URL.
# Keep ?sslmode=require (and channel_binding=require if Neon shows it); both are handled.

# --- Application roles (created by `python -m finqon.db.bootstrap_roles`) ---------------
# The password you put in each URL becomes that role's password.
FINQON_API_DATABASE_URL=       # role finqon_api    (auth, conversations, usage)
FINQON_READER_DATABASE_URL=    # role finqon_reader (model-written SQL; NOSUPERUSER NOBYPASSRLS, read-only)
FINQON_LOADER_DATABASE_URL=    # role finqon_loader (seed loader only)

# --- One-off setup only: the Neon owner ------------------------------------------------
# Used by role bootstrap and Alembic migrations. The running API does not need it.
FINQON_ADMIN_DATABASE_URL=
# Password for the two seed users (kalpeshpawar@gmail.com / seed.isolation@finqon.example).
FINQON_SEED_PASSWORD=

# --- Auth ---------------------------------------------------------------------------------
# At least 32 characters. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
FINQON_JWT_SECRET=
FINQON_JWT_ACCESS_TTL_MINUTES=15
FINQON_JWT_REFRESH_TTL_DAYS=14
FINQON_JWT_ISSUER=finqon.ai

# --- LLM gateway (any OpenAI-compatible endpoint; default is Gemini) -----------------------
FINQON_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
FINQON_LLM_API_KEY=
FINQON_LLM_MODEL=gemini-flash-latest

# --- API ---------------------------------------------------------------------------------
# Comma-separated list of allowed browser origins.
FINQON_CORS_ORIGINS=http://localhost:5173
FINQON_TIMEZONE=Asia/Kolkata
